---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Role from '../components/Role.astro';
import Section from '../components/Section.astro';
import {
  education,
  experiences,
  languages,
  profile,
  skillGroups,
} from '../content';
import { formatMonth } from '../lib/dates';

const updated = new Intl.DateTimeFormat('en', {
  month: 'long',
  year: 'numeric',
}).format(new Date());

const title = `${profile.name} — ${profile.title}`;
const pdfHref = new URL(profile.pdfFileName, profile.siteUrl).href;
const primarySiteLabel = new URL(profile.primarySiteUrl).hostname;
const isDev = import.meta.env.DEV;
---

<Base title={title} description={profile.summary}>
  <Masthead />

  <main>
    <p class="lead intro">{profile.summary}</p>

    <Section id="competencies" label="Core Competencies" className="screen-only">
      <div class="stack">
        {
          skillGroups.map((group) => (
            <div class="group">
              <h3 class="group__label">{group.label}</h3>
              <p class="group__items">{group.items.join(' · ')}</p>
            </div>
          ))
        }
      </div>
    </Section>

    <Section
      id="experience"
      label="Experience"
      meta={`${experiences.length} roles`}
      printMeta={`${experiences.filter((role) => !role.print?.hidden).length} recent roles`}
    >
      <div class="roles">
        {experiences.map((role) => <Role role={role} />)}
      </div>
    </Section>

    {
      education.length > 0 && (
        <Section id="education" label="Education">
          <div class="roles">
            {education.map((entry) => (
              <article class="entry">
                <h3 class="role__title">{entry.degree}</h3>
                <p class="role__org">
                  <span class="role__company">{entry.school}</span>
                  <span class="role__sep" aria-hidden="true">·</span>
                  <span class="role__place">{entry.location}</span>
                </p>
                <p class="tenure">
                  <span class="tenure__dates">
                    <time datetime={entry.start}>{formatMonth(entry.start)}</time>
                    <span aria-hidden="true"> – </span>
                    {entry.end ? (
                      <time datetime={entry.end}>{formatMonth(entry.end)}</time>
                    ) : (
                      <span>Present</span>
                    )}
                  </span>
                </p>
                {entry.highlights.length > 0 && (
                  <ul class="highlights">
                    {entry.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </Section>
      )
    }

    <Section id="languages" label="Languages" className="languages-section">
      <ul class="languages">
        {
          languages.map((language) => (
            <li>
              <b lang={language.code}>{language.name}</b>
              <span>{language.level}</span>
            </li>
          ))
        }
      </ul>
    </Section>
  </main>

  <footer class="colophon screen-only">
    <span>Updated {updated}</span>
    {
      isDev ? (
        <button class="colophon__link" type="button" data-print-button>
          Download PDF
        </button>
      ) : (
        <a href={pdfHref} download>
          Download PDF
        </a>
      )
    }
    <a href={profile.primarySiteUrl} rel="me noopener">{primarySiteLabel}</a>
  </footer>
</Base>
