---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Role from '../components/Role.astro';
import Section from '../components/Section.astro';
import {
  education,
  experiences,
  languages,
  profile,
  skillGroups,
} from '../content';
import { formatMonth } from '../lib/dates';

const updated = new Intl.DateTimeFormat('en', {
  month: 'long',
  year: 'numeric',
}).format(new Date());

const title = `${profile.name} — ${profile.title}`;
---

<Base title={title} description={profile.summary}>
  <Masthead />

  <main>
    <Section id="summary" label="Summary">
      <p class="lead">{profile.summary}</p>
    </Section>

    <Section id="competencies" label="Core Competencies">
      <div class="stack">
        {
          skillGroups.map((group) => (
            <div class="group">
              <h3 class="group__label">{group.label}</h3>
              <p class="group__items">{group.items.join(' · ')}</p>
            </div>
          ))
        }
      </div>
    </Section>

    <Section
      id="experience"
      label="Experience"
      meta={`${experiences.length} roles`}
    >
      <div class="roles">
        {experiences.map((role) => <Role role={role} />)}
      </div>
    </Section>

    {
      education.length > 0 && (
        <Section id="education" label="Education">
          <div class="roles">
            {education.map((entry) => (
              <div class="entry">
                <h3 class="entry__title">{entry.degree}</h3>
                <p class="entry__org">
                  {entry.school} · {entry.location}
                </p>
                <p class="entry__meta">
                  <time datetime={entry.start}>{formatMonth(entry.start)}</time>
                  <span aria-hidden="true"> – </span>
                  {entry.end ? (
                    <time datetime={entry.end}>{formatMonth(entry.end)}</time>
                  ) : (
                    <span>Present</span>
                  )}
                </p>
                {entry.highlights.length > 0 && (
                  <ul class="highlights">
                    {entry.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </Section>
      )
    }

    <Section id="languages" label="Languages">
      <ul class="languages">
        {
          languages.map((language) => (
            <li>
              <b lang={language.code}>{language.name}</b>
              <span>{language.level}</span>
            </li>
          ))
        }
      </ul>
    </Section>
  </main>

  <p class="colophon">
    Updated {updated}
  </p>
</Base>
