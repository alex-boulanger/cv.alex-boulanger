---
interface Props {
  label: string;
  id: string;
  meta?: string;
}

const { label, id, meta } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-label`}>
  <div class="section__head">
    <h2 class="section__label" id={`${id}-label`}>{label}</h2>
    <span class="section__rule" aria-hidden="true"></span>
    {meta && <span class="section__meta">{meta}</span>}
  </div>
  <slot />
</section>
